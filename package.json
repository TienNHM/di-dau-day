{
  "name": "di-dau-day",
  "version": "0.1.0",
  "private": true,
  "description": "Đi Đâu Đây? — decision engine for local experiences in Vietnam",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "npx --yes serve@14 out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm data:shard:check && pnpm typecheck && pnpm lint && pnpm test",
    "generate:og": "tsx scripts/generate-og.ts",
    "generate:icons": "tsx scripts/generate-icons.ts",
    "data:shard": "tsx scripts/shard-data.ts",
    "data:shard:check": "tsx scripts/shard-data.ts --check",
    "prebuild": "pnpm data:shard && pnpm generate:icons && pnpm generate:og",
    "check:layout": "node scripts/check-layout.mjs",
    "data:fetch": "tsx scripts/overture/fetch.ts",
    "data:verify": "tsx scripts/overture/verify.ts",
    "data:apply": "tsx scripts/overture/apply.ts",
    "data:cities": "tsx scripts/overture/cities.ts",
    "data:import": "tsx scripts/overture/import.ts",
    "data:taxonomy": "tsx scripts/overture/taxonomy.ts",
    "data:dishes": "tsx scripts/check-dishes.ts"
  },
  "dependencies": {
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@duckdb/node-api": "1.5.5-r.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.5",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
